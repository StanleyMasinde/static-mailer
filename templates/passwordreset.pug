include layouts/main.pug

+laravelMail({
  title: 'Password Reset Notification',
  preheader: `Reset your ${data.company_name} password with this one-time code.`,
  greeting: 'Hello!',
  outro: [
    'You are receiving this email because we received a password reset request for your account.',
    'If you did not request a password reset, no further action is required.'
  ],
  brandName: data.company_name,
  brandUrl: data.company_url,
  footerText: `${data.company_name}, LLC`
})
  p
    | Use the one-time code below to reset your password:
  p(style='font-size: 28px; font-weight: 700; letter-spacing: 3px; text-align: center; margin: 24px 0; color: #2d3748;')= data.code
  p
    | This code will expire in 60 minutes.
  p
    | This email is intended for #{data.email}.
