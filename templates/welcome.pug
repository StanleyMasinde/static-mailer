include layouts/main.pug

+laravelMail({
  title: `Welcome to ${data.company_name}`,
  preheader: `Welcome to ${data.company_name}. Start by visiting your account.`,
  greeting: `Hello ${data.name}!`,
  buttonText: 'Open Account',
  buttonUrl: `${data.dashboard_url}`,
  outro: [
    `Thanks for trying ${data.company_name}. We are thrilled to have you on board.`,
    'Use your account area to create an API key and start receiving messages from your static site.'
  ],
  brandName: data.company_name,
  brandUrl: data.company_url,
  footerText: `${data.company_name}, LLC`
})
  p
    | Thanks for signing up. This email confirms your account is ready.
  p
    | Your next step is to open your account area and create your first API key.
