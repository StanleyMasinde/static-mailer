include layouts/main.pug

+laravelMail({
  title: `New message from ${email}`,
  preheader: `You received a new message via your ${companyName} delivery endpoint.`,
  greeting: 'Hello!',
  outro: [
    `Message received at ${timestamp}.`
  ],
  brandName: companyName,
  brandUrl: companyUrl,
  footerText: `${companyName}, LLC`
})
  p
    | You received a new message from #{email}.
  table(role='presentation' width='100%' cellpadding='0' cellspacing='0' style='margin: 20px 0; border-left: 4px solid #d2d6dc; background: #f9fafb;')
    tr
      td(style='padding: 16px; font-size: 15px; line-height: 1.6em; white-space: pre-wrap; color: #374151;')= message
